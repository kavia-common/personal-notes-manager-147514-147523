<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/NotesListFragment">

    <fragment
        android:id="@+id/NotesListFragment"
        android:name="com.example.notes.ui.list.NotesListFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_list_to_edit"
            app:destination="@id/NoteEditorFragment" />
    </fragment>

    <fragment
        android:id="@+id/NoteEditorFragment"
        android:name="com.example.notes.ui.edit.NoteEditorFragment"
        android:label="@string/app_name">
        <argument
            android:name="noteId"
            app:argType="long"
            android:defaultValue="-1" />
    </fragment>
</navigation>
